 package catalog
 
+import "sync"
+
 func loadAll(ids []string) map[string]Item {
 	items := make(map[string]Item, len(ids))
+	var mu sync.Mutex
+	var wg sync.WaitGroup
 	for _, id := range ids {
-		items[id] = load(id)
+		id := id
+		wg.Add(1)
+		go func() {
+			defer wg.Done()
+			item := load(id)
+			mu.Lock()
+			items[id] = item
+			mu.Unlock()
+		}()
 	}
+	wg.Wait()
 	return items
 }
