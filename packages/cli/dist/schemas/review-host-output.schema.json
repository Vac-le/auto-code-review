{
  "title": "Auto Code Review report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "scope",
    "summary",
    "findings"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0",
      "type": "string"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base",
        "head"
      ],
      "properties": {
        "kind": {
          "enum": [
            "working-tree",
            "staged",
            "base",
            "commit",
            "branch",
            "path",
            "pull-request"
          ],
          "type": "string"
        },
        "base": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "head": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "findings": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "priority",
        "confidence",
        "category",
        "file",
        "startLine",
        "endLine",
        "side",
        "title",
        "evidence",
        "failureScenario",
        "suggestedFix",
        "fingerprint"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ],
          "type": "string"
        },
        "confidence": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 1
        },
        "category": {
          "enum": [
            "correctness",
            "security",
            "data-integrity",
            "concurrency",
            "performance",
            "compatibility",
            "testing"
          ],
          "type": "string"
        },
        "file": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        "startLine": {
          "type": "integer",
          "minimum": 1
        },
        "endLine": {
          "type": "integer",
          "minimum": 1
        },
        "side": {
          "enum": [
            "new",
            "old"
          ],
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 4,
          "maxLength": 100
        },
        "evidence": {
          "type": "string",
          "minLength": 12,
          "maxLength": 4000
        },
        "failureScenario": {
          "type": "string",
          "minLength": 12,
          "maxLength": 4000
        },
        "suggestedFix": {
          "type": "string",
          "minLength": 4,
          "maxLength": 4000
        },
        "fingerprint": {
          "type": "string",
          "minLength": 6,
          "maxLength": 128
        }
      }
    }
  }
}
