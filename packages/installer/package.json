{
  "name": "@auto-code-review/install",
  "version": "0.2.1",
  "description": "One-command installer for Auto Code Review on Codex and Claude Code",
  "type": "module",
  "bin": {
    "auto-code-review-install": "./src/cli.mjs"
  },
  "files": ["src", "README.md"],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:coverage": "node --experimental-test-coverage --test test/*.test.mjs",
    "build": "node --check src/cli.mjs && node --check src/install.mjs",
    "typecheck": "node --check src/cli.mjs && node --check src/install.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "Apache-2.0",
  "publishConfig": {
    "access": "public"
  }
}
